#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) И Не ЗначениеЗаполнено(Объект.Автор) Тогда
		Объект.Автор = ИмяТекущегоПользователя();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ИмяТекущегоПользователя()

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ЗначениеЗаполнено(ПользовательИБ.ПолноеИмя) Тогда
		Возврат ПользовательИБ.ПолноеИмя;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПользовательИБ.Имя) Тогда
		Возврат ПользовательИБ.Имя;
	КонецЕсли;
	Возврат "Администратор";

КонецФункции

#КонецОбласти
