#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Автор) Тогда
		Автор = ИмяТекущегоПользователя();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Если Цены.Количество() = 0 Тогда
		СообщитьПользователю("Добавьте хотя бы одну строку с услугой.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	УжеЕсть = Новый Соответствие;

	Для Каждого СтрокаЦены Из Цены Цикл

		Если Не ЗначениеЗаполнено(СтрокаЦены.Услуга) Тогда
			СообщитьПользователю(
				"В строке " + СтрокаЦены.НомерСтроки + " не выбрана услуга.",
				"Цены[" + (СтрокаЦены.НомерСтроки - 1) + "].Услуга");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Если СтрокаЦены.Цена <= 0 Тогда
			СообщитьПользователю(
				"В строке " + СтрокаЦены.НомерСтроки + " цена должна быть больше нуля.",
				"Цены[" + (СтрокаЦены.НомерСтроки - 1) + "].Цена");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		Если УжеЕсть.Получить(СтрокаЦены.Услуга) <> Неопределено Тогда
			СообщитьПользователю(
				"Услуга """ + СтрокаЦены.Услуга + """ указана дважды.",
				"Цены[" + (СтрокаЦены.НомерСтроки - 1) + "].Услуга");
			Отказ = Истина;
			Продолжить;
		КонецЕсли;

		УжеЕсть.Вставить(СтрокаЦены.Услуга, Истина);

	КонецЦикла;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.ЦеныУслуг.Записывать = Истина;
	Движения.ЦеныУслуг.Очистить();

	Для Каждого СтрокаЦены Из Цены Цикл

		Движение = Движения.ЦеныУслуг.Добавить();
		Движение.Период = Дата;
		Движение.Услуга = СтрокаЦены.Услуга;
		Движение.Цена = СтрокаЦены.Цена;
		Движение.Автор = Автор;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяТекущегоПользователя()

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ЗначениеЗаполнено(ПользовательИБ.ПолноеИмя) Тогда
		Возврат ПользовательИБ.ПолноеИмя;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПользовательИБ.Имя) Тогда
		Возврат ПользовательИБ.Имя;
	КонецЕсли;
	Возврат "Администратор";

КонецФункции

Процедура СообщитьПользователю(Текст, Поле = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если ЗначениеЗаполнено(Поле) Тогда
		Сообщение.Поле = Поле;
		Сообщение.УстановитьДанные(ЭтотОбъект);
	КонецЕсли;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
