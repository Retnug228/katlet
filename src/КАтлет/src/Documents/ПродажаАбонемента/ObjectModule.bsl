#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий


Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Спортсмен) Тогда
        Отказ = Истина;
        Сообщить("Не указан спортсмен.");
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Карта) Тогда
        Отказ = Истина;
        Сообщить("Не указана клубная карта.");
        Возврат;
    КонецЕсли;

    Если Абонементы.Количество() = 0 Тогда
        Отказ = Истина;
        Сообщить("Добавьте хотя бы один абонемент.");
        Возврат;
    КонецЕсли;

    Попытка
        РегистрыСведений.СтатусыАбонементов.ЗарегистрироватьПоДокументуПродажи(Ссылка);
    Исключение
        Отказ = Истина;
        Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        Возврат;
    КонецПопытки;

    СтатьяДохода = Справочники.СтатьиДоходовИРасходов.НайтиПоНаименованию(
        "Выручка от продажи услуг"
    );

    Если Не ЗначениеЗаполнено(СтатьяДохода) Тогда
        Сообщить("Не найдена статья «Выручка от продажи услуг».");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    СуммаПродажи = 0;

    Для Каждого СтрокаАбонемента Из Абонементы Цикл
        СуммаПродажи = СуммаПродажи + СтрокаАбонемента.Сумма;
    КонецЦикла;

    Движения.ДоходыИРасходы.Записывать = Истина;

    Движение = Движения.ДоходыИРасходы.Добавить();

    Движение.Период = Дата;
    Движение.Статья = СтатьяДохода;
    Движение.ВидОперации =
        Перечисления.ВидыФинансовыхОпераций.Доход;
    Движение.Сумма = СуммаПродажи;

КонецПроцедуры


Процедура ОбработкаУдаленияПроведения(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	РегистрыСведений.СтатусыАбонементов.УдалитьПоДокументуПродажи(Ссылка);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
