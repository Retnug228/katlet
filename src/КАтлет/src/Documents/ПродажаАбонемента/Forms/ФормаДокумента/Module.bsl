
&НаКлиенте
Процедура СпортсменПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(Объект.Спортсмен) Тогда
		Объект.Карта = Неопределено;
		Возврат;
	КонецЕсли;

	Объект.Карта = ПолучитьКартуСпортсменаНаСервере(Объект.Спортсмен);

КонецПроцедуры

&НаКлиенте
Процедура АбонементыВидАбонементаПриИзменении(Элемент)

	ИдентификаторСтроки = Элементы.Абонементы.ТекущаяСтрока;
	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьСтрокуПоВидуНаСервере(ИдентификаторСтроки);

КонецПроцедуры

&НаКлиенте
Процедура АбонементыКоличествоПосещенийПриИзменении(Элемент)

	ИдентификаторСтроки = Элементы.Абонементы.ТекущаяСтрока;
	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПересчитатьСуммуСтрокиНаСервере(ИдентификаторСтроки);

КонецПроцедуры

&НаКлиенте
Процедура АбонементыУслугаПриИзменении(Элемент)

	ИдентификаторСтроки = Элементы.Абонементы.ТекущаяСтрока;
	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПересчитатьСуммуСтрокиНаСервере(ИдентификаторСтроки);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКартуСпортсменаНаСервере(Спортсмен)

	Возврат Справочники.КлубныеКарты.НайтиИлиСоздатьДляСпортсмена(Спортсмен);

КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокуПоВидуНаСервере(ИдентификаторСтроки)

	СтрокаТЧ = Объект.Абонементы.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтрокаТЧ.ВидАбонемента) Тогда
		Возврат;
	КонецЕсли;

	Вид = СтрокаТЧ.ВидАбонемента;

	СтрокаТЧ.Услуга = Вид.Услуга;
	СтрокаТЧ.КоличествоПосещений = Вид.КоличествоПосещений;
	СтрокаТЧ.МесяцевДлительность = Вид.ДлительностьМесяцев;
	СтрокаТЧ.ДнейДлительность = Вид.ДлительностьДней;
	СтрокаТЧ.ОграниченаДеятельность = Вид.ОграниченаДлительность;
	СтрокаТЧ.Групповой = (Вид.ТипАбонемента = Перечисления.ТипыАбонементов.Групповой);

	Если Вид.ВозможностьЗаморозки Тогда
		СтрокаТЧ.ДоступноеКоличествоЗаморозок = 1;
	Иначе
		СтрокаТЧ.ДоступноеКоличествоЗаморозок = 0;
	КонецЕсли;

	Если Не СтрокаТЧ.Групповой Тогда
		СтрокаТЧ.Группа = Неопределено;
	КонецЕсли;

	СтрокаТЧ.ДатаНачала = НачалоДня(Объект.Дата);
	СтрокаТЧ.ДатаОкончания = ДобавитьМесяц(СтрокаТЧ.ДатаНачала, СтрокаТЧ.МесяцевДлительность);
	СтрокаТЧ.ДатаОкончания = СтрокаТЧ.ДатаОкончания
		+ СтрокаТЧ.ДнейДлительность * 24 * 60 * 60;
		
	ПересчитатьСуммуСтрокиНаСервере(ИдентификаторСтроки);

КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуСтрокиНаСервере(ИдентификаторСтроки)
	СтрокаТЧ = Объект.Абонементы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	Если СтрокаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТЧ.Услуга) Тогда
		СтрокаТЧ.Сумма = 0;
		ПересчитатьСуммуДокументаНаСервере();
		Возврат;
	КонецЕсли;
	
	ДатаЦены = КонецДня(Объект.Дата);
	ЦенаПосещения = ПолучитьЦенуПосещения(ДатаЦены);
	СтоимостьУслуги = ПолучитьЦенуУслуги(СтрокаТЧ.Услуга, ДатаЦены);
	
	Если ЦенаПосещения = Неопределено Тогда
		Сообщить("Не найдена цена услуги «Цена посещения». Установите её документом «Установка цен услуг».");
		СтрокаТЧ.Сумма = 0;
		ПересчитатьСуммуДокументаНаСервере();
		Возврат;
	КонецЕсли;
	
	Если СтоимостьУслуги = Неопределено Тогда
		Сообщить("Не найдена стоимость услуги «" + СтрокаТЧ.Услуга + "».");
		СтрокаТЧ.Сумма = 0;
		ПересчитатьСуммуДокументаНаСервере();
		Возврат;
	КонецЕсли;

	СтрокаТЧ.Сумма =
		СтрокаТЧ.КоличествоПосещений * ЦенаПосещения
		+ СтоимостьУслуги;
	ПересчитатьСуммуДокументаНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуДокументаНаСервере()
	СуммаИтого = 0;
	
	Для Каждого СтрокаТЧ Из Объект.Абонементы Цикл
		СуммаИтого = СуммаИтого + СтрокаТЧ.Сумма;
	КонецЦикла;
	
	Объект.СуммаДокумента = СуммаИтого;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуПосещения(ДатаЦены)
	УслугаЦенаПосещения = Справочники.Услуги.НайтиПоНаименованию("Цена посещения", Истина);
	
	Если Не ЗначениеЗаполнено(УслугаЦенаПосещения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолучитьЦенуУслуги(УслугаЦенаПосещения, ДатаЦены);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЦенуУслуги(Услуга, ДатаЦены)
	Если Не ЗначениеЗаполнено(Услуга) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЦеныУслуг.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныУслуг.СрезПоследних(&ДатаЦены, Услуга = &Услуга) КАК ЦеныУслуг";
	Запрос.УстановитьПараметр("ДатаЦены", ДатаЦены);
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

