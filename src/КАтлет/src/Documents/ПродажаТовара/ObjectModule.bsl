#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Администратор) Тогда
        Администратор = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    // Получение статьи дохода
    СтатьяДохода = Справочники.СтатьиДоходовИРасходов.НайтиПоНаименованию(
        "Выручка от продажи товаров"
    );

    Если Не ЗначениеЗаполнено(СтатьяДохода) Тогда
        Сообщить("Не найдена статья «Выручка от продажи товаров».");
        Отказ = Истина;
        Возврат;
    КонецЕсли;


    // Подготовка движений по остаткам
    Движения.ОстаткиТоваров.Записывать = Истина;

    // Объединение одинаковых товаров
    КоличествоПоТоварам = Новый Соответствие;

    Для Каждого СтрокаТовара Из ПродажаТоваров Цикл

        КоличествоТовара = КоличествоПоТоварам.Получить(
            СтрокаТовара.Товар
        );

        Если КоличествоТовара = Неопределено Тогда
            КоличествоТовара = 0;
        КонецЕсли;

        КоличествоПоТоварам.Вставить(
            СтрокаТовара.Товар,
            КоличествоТовара + СтрокаТовара.Количество
        );

    КонецЦикла;


    // Получение остатков всех товаров одним запросом

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ
    |   Остатки.Товар КАК Товар,
    |   Остатки.СрокГодности КАК СрокГодности,
    |   Остатки.КоличествоОстаток КАК КоличествоОстаток
    |ИЗ
    |   РегистрНакопления.ОстаткиТоваров.Остатки(
    |       &Момент,
    |   ) КАК Остатки
    |ГДЕ
    |   Остатки.КоличествоОстаток > 0
    |   И (
    |       Остатки.СрокГодности = ДАТАВРЕМЯ(1, 1, 1)
    |       ИЛИ Остатки.СрокГодности >= &НачалоДня
    |   )
    |УПОРЯДОЧИТЬ ПО
    |   Остатки.Товар,
    |   ВЫБОР
    |       КОГДА Остатки.СрокГодности = ДАТАВРЕМЯ(1, 1, 1)
    |           ТОГДА 1
    |       ИНАЧЕ 0
    |   КОНЕЦ,
    |   Остатки.СрокГодности";

    Запрос.УстановитьПараметр("Момент", Дата);
    Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Дата));

    ВыборкаОстатков = Запрос.Выполнить().Выбрать();

    Для Каждого Элемент Из КоличествоПоТоварам Цикл

        ТоварДляСписания = Элемент.Ключ;
        ОсталосьСписать = Элемент.Значение;

        ВыборкаОстатков.Сбросить();

        Пока ВыборкаОстатков.Следующий()
            И ОсталосьСписать > 0 Цикл

            Если ВыборкаОстатков.Товар <> ТоварДляСписания Тогда
                Продолжить;
            КонецЕсли;

            Если ВыборкаОстатков.КоличествоОстаток >= ОсталосьСписать Тогда
                КоличествоСписания = ОсталосьСписать;
            Иначе
                КоличествоСписания = ВыборкаОстатков.КоличествоОстаток;
            КонецЕсли;

            ДвижениеТовара = Движения.ОстаткиТоваров.Добавить();

            ДвижениеТовара.ВидДвижения =
                ВидДвиженияНакопления.Расход;

            ДвижениеТовара.Период = Дата;
            ДвижениеТовара.Товар = ТоварДляСписания;
            ДвижениеТовара.СрокГодности =
                ВыборкаОстатков.СрокГодности;
            ДвижениеТовара.Количество = КоличествоСписания;

            ОсталосьСписать = ОсталосьСписать - КоличествоСписания;

        КонецЦикла;

        Если ОсталосьСписать > 0 Тогда

            Сообщить(
                "Недостаточно товара «"
                + Строка(ТоварДляСписания)
                + "» с действующим сроком годности. Не хватает: "
                + Строка(ОсталосьСписать)
            );

            Отказ = Истина;
            Возврат;

        КонецЕсли;

    КонецЦикла;


    // Запись выручки

    Движения.ДоходыИРасходы.Записывать = Истина;

    Движение = Движения.ДоходыИРасходы.Добавить();

    Движение.Период = Дата;
    Движение.Статья = СтатьяДохода;
    Движение.ВидОперации =
        Перечисления.ВидыФинансовыхОпераций.Доход;
    Движение.Сумма = ИтоговаяСумма;

КонецПроцедуры