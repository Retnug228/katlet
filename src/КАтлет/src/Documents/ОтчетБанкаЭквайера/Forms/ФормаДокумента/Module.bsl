&НаКлиенте
Процедура ЗаполнитьПоДаннымБанка(Команда)

    ЗаполнитьОплатыПоДаннымБанкаНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОплатыПоДаннымБанкаНаСервере()

    Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
        Сообщить("Укажите дату поступления денежных средств.");
        Возврат;
    КонецЕсли;

    НачалоПериода = НачалоДня(Объект.Дата) - 86400;
    КонецПериода = НачалоДня(Объект.Дата);

    ЗапросИспользованныхОплат = Новый Запрос;


	ЗапросИспользованныхОплат.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|   ОплатыКартой.Оплата КАК Оплата
	|ИЗ
	|   Документ.ОтчетБанкаЭквайера.ОплатыКартой КАК ОплатыКартой
	|ГДЕ
	|   ОплатыКартой.Ссылка В
	|       (ВЫБРАТЬ
	|           Отчет.Ссылка
	|       ИЗ
	|           Документ.ОтчетБанкаЭквайера КАК Отчет
	|       ГДЕ
	|           Отчет.Проведен = ИСТИНА
	|           И Отчет.Ссылка <> &ТекущийОтчет)";
	
	ЗапросИспользованныхОплат.УстановитьПараметр(
	    "ТекущийОтчет", Объект.Ссылка);
	
	РезультатИспользованныхОплат =
	    ЗапросИспользованныхОплат.Выполнить();
	
	ВыборкаИспользованныхОплат =
	    РезультатИспользованныхОплат.Выбрать();
	
	ИспользованныеОплаты = Новый Массив;
	
	Пока ВыборкаИспользованныхОплат.Следующий() Цикл
	
	    ИспользованныеОплаты.Добавить(
	        ВыборкаИспользованныхОплат.Оплата);
	
	КонецЦикла;

    Объект.ОплатыКартой.Очистить();

    Объект.ОбщаяСуммаОплат = 0;
    Объект.ОбщаяКомиссия = 0;
    Объект.СуммаПоступления = 0;

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ
    |   Оплата.Ссылка КАК Оплата,
    |   Оплата.СуммаОплаты КАК СуммаОплаты
    |ИЗ
    |   Документ.Оплата КАК Оплата
    |ГДЕ
    |   Оплата.Проведен = ИСТИНА
    |   И Оплата.СпособОплаты =
    |       ЗНАЧЕНИЕ(Перечисление.СпособыОплаты.БанковскаяКарта)
    |   И Оплата.Дата >= &НачалоПериода
    |   И Оплата.Дата < &КонецПериода";

    Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
    Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();

    КоличествоОплат = 0;

    Пока Выборка.Следующий() Цикл

        Если ИспользованныеОплаты.Найти(Выборка.Оплата) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;

        СтрокаОплаты = Объект.ОплатыКартой.Добавить();

        СтрокаОплаты.Оплата = Выборка.Оплата;
        СтрокаОплаты.СуммаОплаты = Выборка.СуммаОплаты;

        СтрокаОплаты.Комиссия =
            Окр(Выборка.СуммаОплаты * 1.257 / 100, 2);

        СтрокаОплаты.СуммаПоступления =
            СтрокаОплаты.СуммаОплаты - СтрокаОплаты.Комиссия;

        Объект.ОбщаяСуммаОплат =
            Объект.ОбщаяСуммаОплат + СтрокаОплаты.СуммаОплаты;

        Объект.ОбщаяКомиссия =
            Объект.ОбщаяКомиссия + СтрокаОплаты.Комиссия;

        Объект.СуммаПоступления =
            Объект.СуммаПоступления + СтрокаОплаты.СуммаПоступления;

        КоличествоОплат = КоличествоОплат + 1;

    КонецЦикла;

    Если КоличествоОплат = 0 Тогда
        Сообщить("За предыдущий день не найдено новых проведенных оплат банковской картой.");
    Иначе
        Сообщить("Заполнение завершено. Найдено оплат: " + КоличествоОплат);
    КонецЕсли;

КонецПроцедуры