Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Если ОплатыКартой.Количество() = 0 Тогда
        Сообщить("Нельзя провести отчет без оплат банковской картой.");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    СтатьяБанковскихРасходов =
        Справочники.СтатьиДоходовИРасходов.НайтиПоНаименованию(
            "Расходы на услуги банков");

    Если Не ЗначениеЗаполнено(СтатьяБанковскихРасходов) Тогда
        Сообщить("Не найдена статья расходов «Расходы на услуги банков».");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    Если СтатьяБанковскихРасходов.ВидФинансовойОперации <>
        Перечисления.ВидыФинансовыхОпераций.Расход Тогда

        Сообщить("Статья «Расходы на услуги банков» должна иметь вид операции «Расход».");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Запрос = Новый Запрос;

    Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|   ТекущиеОплаты.Оплата КАК НайденнаяОплата
	|ИЗ
	|   Документ.ОтчетБанкаЭквайера.ОплатыКартой КАК ТекущиеОплаты
	|ГДЕ
	|   ТекущиеОплаты.Оплата В (&ОплатыТекущегоОтчета)
	|   И ТекущиеОплаты.Ссылка В
	|       (ВЫБРАТЬ
	|           Отчет.Ссылка
	|       ИЗ
	|           Документ.ОтчетБанкаЭквайера КАК Отчет
	|       ГДЕ
	|           Отчет.Проведен = ИСТИНА
	|           И Отчет.Ссылка <> &ТекущийОтчет)";

    МассивОплат = Новый Массив;

    Для Каждого СтрокаОплаты Из ОплатыКартой Цикл
        МассивОплат.Добавить(СтрокаОплаты.Оплата);
    КонецЦикла;

    Запрос.УстановитьПараметр("ОплатыТекущегоОтчета", МассивОплат);
    Запрос.УстановитьПараметр("ТекущийОтчет", Ссылка);

    РезультатЗапроса = Запрос.Выполнить();

    Если Не РезультатЗапроса.Пустой() Тогда
        Сообщить("Одна или несколько оплат уже включены в другой проведенный отчет банка.");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    Движения.ДоходыИРасходы.Записывать = Истина;

    Движение = Движения.ДоходыИРасходы.Добавить();

    Движение.Период = Дата;
    Движение.Статья = СтатьяБанковскихРасходов;
    Движение.ВидОперации =
        Перечисления.ВидыФинансовыхОпераций.Расход;
    Движение.Сумма = ОбщаяКомиссия;

КонецПроцедуры