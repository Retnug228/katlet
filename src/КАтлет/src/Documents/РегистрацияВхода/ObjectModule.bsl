#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	КодКарты = СокрЛП(КодКарты);

	Если Не ЗначениеЗаполнено(КодКарты) Тогда
		Отказ = Истина;
		СообщитьПользователю("Укажите код клубной карты.", "КодКарты");
		Возврат;
	КонецЕсли;

	ЗаполнитьПоКодуКарты(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда

		Если Не ЗначениеЗаполнено(ДокументПродажи) Или Не ЗначениеЗаполнено(НомерСтрокиАбонемента) Тогда
			Отказ = Истина;
			СообщитьПользователю("Не найден действующий абонемент по этой карте.", "КодКарты");
			Возврат;
		КонецЕсли;

		ПодготовитьРеквизитыПередПроведением(Отказ);

	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Попытка
		РезультатСписания = РегистрыСведений.СтатусыАбонементов.СписатьПосещение(
			ДокументПродажи,
			НомерСтрокиАбонемента,
			Дата);
	Исключение
		Отказ = Истина;
		СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "КодКарты");
		Возврат;
	КонецПопытки;

	Если РезультатСписания.ОстатокПосещений <= 3 Тогда
		ТекстПредупреждения = СтрШаблон(
			"Внимание: по абонементу осталось %1 входа(ов). Абонемент скоро завершится.",
			РезультатСписания.ОстатокПосещений);
		СообщитьПользователю(ТекстПредупреждения);
	КонецЕсли;

	Если РезультатСписания.СнятаЗаморозка Тогда
		СообщитьПользователю("Заморозка абонемента снята при входе.");
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	Если ЗначениеЗаполнено(ДокументПродажи) И ЗначениеЗаполнено(НомерСтрокиАбонемента) Тогда
		РегистрыСведений.СтатусыАбонементов.ВернутьПосещение(ДокументПродажи, НомерСтрокиАбонемента);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоКодуКарты(Отказ)

	Карта = Справочники.КлубныеКарты.НайтиПоНомеру(КодКарты);
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Отказ = Истина;
		СообщитьПользователю("Клубная карта с кодом """ + КодКарты + """ не найдена.", "КодКарты");
		Возврат;
	КонецЕсли;

	КлубнаяКарта = Карта;
	Спортсмен = Карта.ВладелецКарты;

	Абонемент = РегистрыСведений.СтатусыАбонементов.НайтиДействующийАбонементПоКарте(Карта, Дата);
	Если Абонемент = Неопределено Тогда
		Отказ = Истина;
		СообщитьПользователю(
			"Для карты """ + КодКарты + """ нет действующего абонемента с посещениями.",
			"КодКарты");
		Возврат;
	КонецЕсли;

	ДокументПродажи = Абонемент.ДокументПродажи;
	НомерСтрокиАбонемента = Абонемент.НомерСтрокиАбонемента;
	ВидАбонемента = Абонемент.ВидАбонемента;
	Если ЗначениеЗаполнено(Абонемент.Спортсмен) Тогда
		Спортсмен = Абонемент.Спортсмен;
	КонецЕсли;

КонецПроцедуры

Процедура ПодготовитьРеквизитыПередПроведением(Отказ)

	МенеджерЗаписи = РегистрыСведений.СтатусыАбонементов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДокументПродажи = ДокументПродажи;
	МенеджерЗаписи.НомерСтрокиАбонемента = НомерСтрокиАбонемента;
	МенеджерЗаписи.Прочитать();

	Если Не МенеджерЗаписи.Выбран() Тогда
		Отказ = Истина;
		СообщитьПользователю("Статус абонемента не найден.", "КодКарты");
		Возврат;
	КонецЕсли;

	Если МенеджерЗаписи.ОстатокПосещений <= 0 Тогда
		Отказ = Истина;
		СообщитьПользователю("По абонементу не осталось посещений.", "КодКарты");
		Возврат;
	КонецЕсли;

	ДатаВхода = НачалоДня(Дата);
	СнятаЗаморозка = Ложь;

	Если МенеджерЗаписи.Заморожен
		И ЗначениеЗаполнено(МенеджерЗаписи.ДатаНачалаЗаморозки)
		И МенеджерЗаписи.ДатаНачалаЗаморозки <= ДатаВхода
		И (Не ЗначениеЗаполнено(МенеджерЗаписи.ДатаОкончанияЗаморозки)
			Или МенеджерЗаписи.ДатаОкончанияЗаморозки >= ДатаВхода) Тогда
		СнятаЗаморозка = Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(МенеджерЗаписи.ДатаОкончания)
		И МенеджерЗаписи.ДатаОкончания < ДатаВхода
		И Не СнятаЗаморозка Тогда
		Отказ = Истина;
		СообщитьПользователю("Срок действия абонемента истёк.", "КодКарты");
		Возврат;
	КонецЕсли;

	ОстатокПослеВхода = МенеджерЗаписи.ОстатокПосещений - 1;

КонецПроцедуры

Процедура СообщитьПользователю(Текст, Поле = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если ЗначениеЗаполнено(Поле) Тогда
		Сообщение.Поле = Поле;
		Сообщение.УстановитьДанные(ЭтотОбъект);
	КонецЕсли;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
