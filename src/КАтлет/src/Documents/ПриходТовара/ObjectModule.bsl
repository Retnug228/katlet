Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    // Запись расходов на закупку товаров

    СтатьяРасхода = Справочники.СтатьиДоходовИРасходов.НайтиПоНаименованию(
        "Закупка товаров"
    );

    Если Не ЗначениеЗаполнено(СтатьяРасхода) Тогда
        Сообщить("Не найдена статья расходов «Закупка товаров».");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    Движения.ДоходыИРасходы.Записывать = Истина;

    Движение = Движения.ДоходыИРасходы.Добавить();

    Движение.Период = Дата;
    Движение.Статья = СтатьяРасхода;
    Движение.ВидОперации = Перечисления.ВидыФинансовыхОпераций.Расход;
    Движение.Сумма = СуммаДокумента;


    // Учёт поступления товаров

    Движения.ОстаткиТоваров.Записывать = Истина;

    Для Каждого СтрокаТовара Из Товары Цикл

        ДвижениеТовара = Движения.ОстаткиТоваров.Добавить();

        ДвижениеТовара.ВидДвижения = ВидДвиженияНакопления.Приход;
        ДвижениеТовара.Период = Дата;
        ДвижениеТовара.Товар = СтрокаТовара.Товар;
        ДвижениеТовара.СрокГодности = СтрокаТовара.СрокГодности;
        ДвижениеТовара.Количество = СтрокаТовара.Количество;

    КонецЦикла;

КонецПроцедуры