#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	КодКарты = СокрЛП(КодКарты);

	Если Не ЗначениеЗаполнено(КодКарты) Тогда
		Отказ = Истина;
		СообщитьПользователю("Укажите код клубной карты.", "КодКарты");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачалаЗаморозки) Тогда
		Отказ = Истина;
		СообщитьПользователю("Укажите дату начала заморозки.", "ДатаНачалаЗаморозки");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОкончанияЗаморозки) Тогда
		Отказ = Истина;
		СообщитьПользователю("Укажите дату окончания заморозки.", "ДатаОкончанияЗаморозки");
		Возврат;
	КонецЕсли;

	ДатаНачалаЗаморозки = НачалоДня(ДатаНачалаЗаморозки);
	ДатаОкончанияЗаморозки = НачалоДня(ДатаОкончанияЗаморозки);

	Если ДатаОкончанияЗаморозки < ДатаНачалаЗаморозки Тогда
		Отказ = Истина;
		СообщитьПользователю(
			"Дата окончания заморозки не может быть раньше даты начала.",
			"ДатаОкончанияЗаморозки");
		Возврат;
	КонецЕсли;

	Если ДатаОкончанияЗаморозки > ДобавитьМесяц(ДатаНачалаЗаморозки, 3) Тогда
		Отказ = Истина;
		СообщитьПользователю(
			"Срок заморозки не может превышать 3 месяца.",
			"ДатаОкончанияЗаморозки");
		Возврат;
	КонецЕсли;

	ЗаполнитьПоКодуКарты(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ДнейПродления = ДатаОкончанияЗаморозки - ДатаНачалаЗаморозки;
	Если ДнейПродления < 0 Тогда
		ДнейПродления = 0;
	КонецЕсли;

	Если ЗначениеЗаполнено(ДатаОкончанияДо) Тогда
		ДатаОкончанияПосле = ДатаОкончанияДо + ДнейПродления;
	КонецЕсли;

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда

		Если Не ЗначениеЗаполнено(ДокументПродажи) Или Не ЗначениеЗаполнено(НомерСтрокиАбонемента) Тогда
			Отказ = Истина;
			СообщитьПользователю("Не найден абонемент для заморозки по этой карте.", "КодКарты");
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Попытка
		Результат = РегистрыСведений.СтатусыАбонементов.ЗаморозитьАбонемент(
			ДокументПродажи,
			НомерСтрокиАбонемента,
			ДатаНачалаЗаморозки,
			ДатаОкончанияЗаморозки);
	Исключение
		Отказ = Истина;
		СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), "КодКарты");
		Возврат;
	КонецПопытки;

	СообщитьПользователю(СтрШаблон(
		"Абонемент заморожен. Срок действия продлён на %1 дн.: до %2.",
		Результат.ДнейПродления,
		Формат(Результат.ДатаОкончанияПосле, "ДЛФ=D")));

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	Если ЗначениеЗаполнено(ДокументПродажи) И ЗначениеЗаполнено(НомерСтрокиАбонемента) Тогда
		РегистрыСведений.СтатусыАбонементов.ОтменитьЗаморозку(
			ДокументПродажи,
			НомерСтрокиАбонемента,
			ДнейПродления);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоКодуКарты(Отказ)

	Карта = Справочники.КлубныеКарты.НайтиПоНомеру(КодКарты);
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Отказ = Истина;
		СообщитьПользователю("Клубная карта с кодом """ + КодКарты + """ не найдена.", "КодКарты");
		Возврат;
	КонецЕсли;

	КлубнаяКарта = Карта;
	Спортсмен = Карта.ВладелецКарты;

	Абонемент = РегистрыСведений.СтатусыАбонементов.НайтиДействующийАбонементПоКарте(Карта, Дата);
	Если Абонемент = Неопределено Тогда
		Отказ = Истина;
		СообщитьПользователю(
			"Для карты """ + КодКарты + """ не найден абонемент для заморозки.",
			"КодКарты");
		Возврат;
	КонецЕсли;

	Если Абонемент.Заморожен Тогда
		Отказ = Истина;
		СообщитьПользователю("Абонемент по этой карте уже заморожен.", "КодКарты");
		Возврат;
	КонецЕсли;

	ДокументПродажи = Абонемент.ДокументПродажи;
	НомерСтрокиАбонемента = Абонемент.НомерСтрокиАбонемента;
	ВидАбонемента = Абонемент.ВидАбонемента;
	ДатаОкончанияДо = Абонемент.ДатаОкончания;

	Если ЗначениеЗаполнено(Абонемент.Спортсмен) Тогда
		Спортсмен = Абонемент.Спортсмен;
	КонецЕсли;

КонецПроцедуры

Процедура СообщитьПользователю(Текст, Поле = "")

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если ЗначениеЗаполнено(Поле) Тогда
		Сообщение.Поле = Поле;
		Сообщение.УстановитьДанные(ЭтотОбъект);
	КонецЕсли;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#КонецЕсли
