#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ДатаНачалаЗаморозки) Тогда
			Объект.ДатаНачалаЗаморозки = НачалоДня(ТекущаяДатаСеанса());
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КодКартыПриИзменении(Элемент)

	ЗаполнитьПоКодуКартыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаЗаморозкиПриИзменении(Элемент)

	ПересчитатьПродлениеНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияЗаморозкиПриИзменении(Элемент)

	ПересчитатьПродлениеНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПоКодуКартыНаСервере()

	Объект.КодКарты = СокрЛП(Объект.КодКарты);
	Объект.КлубнаяКарта = Неопределено;
	Объект.Спортсмен = Неопределено;
	Объект.ДокументПродажи = Неопределено;
	Объект.НомерСтрокиАбонемента = 0;
	Объект.ВидАбонемента = Неопределено;
	Объект.ДатаОкончанияДо = '00010101';
	Объект.ДатаОкончанияПосле = '00010101';
	Объект.ДнейПродления = 0;

	Если Не ЗначениеЗаполнено(Объект.КодКарты) Тогда
		Возврат;
	КонецЕсли;

	Карта = Справочники.КлубныеКарты.НайтиПоНомеру(Объект.КодКарты);
	Если Не ЗначениеЗаполнено(Карта) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Клубная карта с кодом """ + Объект.КодКарты + """ не найдена.";
		Сообщение.Поле = "Объект.КодКарты";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Объект.КлубнаяКарта = Карта;
	Объект.Спортсмен = Карта.ВладелецКарты;

	Абонемент = РегистрыСведений.СтатусыАбонементов.НайтиДействующийАбонементПоКарте(Карта, Объект.Дата);
	Если Абонемент = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Для карты """ + Объект.КодКарты + """ не найден абонемент для заморозки.";
		Сообщение.Поле = "Объект.КодКарты";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Если Абонемент.Заморожен Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Абонемент по этой карте уже заморожен.";
		Сообщение.Поле = "Объект.КодКарты";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Объект.ДокументПродажи = Абонемент.ДокументПродажи;
	Объект.НомерСтрокиАбонемента = Абонемент.НомерСтрокиАбонемента;
	Объект.ВидАбонемента = Абонемент.ВидАбонемента;
	Объект.ДатаОкончанияДо = Абонемент.ДатаОкончания;
	Если ЗначениеЗаполнено(Абонемент.Спортсмен) Тогда
		Объект.Спортсмен = Абонемент.Спортсмен;
	КонецЕсли;

	ПересчитатьПродлениеНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПересчитатьПродлениеНаСервере()

	Если Не ЗначениеЗаполнено(Объект.ДатаНачалаЗаморозки)
		Или Не ЗначениеЗаполнено(Объект.ДатаОкончанияЗаморозки) Тогда
		Объект.ДнейПродления = 0;
		Объект.ДатаОкончанияПосле = Объект.ДатаОкончанияДо;
		Возврат;
	КонецЕсли;

	НачалоПериода = НачалоДня(Объект.ДатаНачалаЗаморозки);
	КонецПериода = НачалоДня(Объект.ДатаОкончанияЗаморозки);

	Если КонецПериода < НачалоПериода Тогда
		Объект.ДнейПродления = 0;
		Объект.ДатаОкончанияПосле = Объект.ДатаОкончанияДо;
		Возврат;
	КонецЕсли;

	Объект.ДнейПродления = КонецПериода - НачалоПериода;
	Если ЗначениеЗаполнено(Объект.ДатаОкончанияДо) Тогда
		Объект.ДатаОкончанияПосле = Объект.ДатаОкончанияДо + Объект.ДнейПродления;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
