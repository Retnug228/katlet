Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Если Не ЗначениеЗаполнено(СтатьяРасхода) Тогда
        Сообщить("Необходимо выбрать статью расхода.");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    Если СтатьяРасхода.ВидФинансовойОперации <>
        Перечисления.ВидыФинансовыхОпераций.Расход Тогда

        Сообщить("Выбранная статья не относится к расходам.");
        Отказ = Истина;
        Возврат;

    КонецЕсли;

    Если Сумма <= 0 Тогда
        Сообщить("Сумма расхода должна быть больше нуля.");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    Движения.ДоходыИРасходы.Записывать = Истина;

    Движение = Движения.ДоходыИРасходы.Добавить();
    Движение.Период = Дата;
    Движение.Статья = СтатьяРасхода;
    Движение.ВидОперации =
        Перечисления.ВидыФинансовыхОпераций.Расход;
    Движение.Сумма = Сумма;

КонецПроцедуры