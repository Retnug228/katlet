&НаКлиенте
Процедура ПечатьЧека(Команда)

	Если Объект.Ссылка.Пустая() Тогда
		Сообщить("Сначала запишите документ оплаты.");
		Возврат;
	КонецЕсли;

	ТабДок = СформироватьЧекНаСервере(Объект.Ссылка);
	ТабДок.Показать("Чек");

КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьЧекНаСервере(ДокументСсылка)

	Возврат Документы.Оплата.СформироватьПечатнуюФормуЧек(ДокументСсылка);

КонецФункции

&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Объект.Спортсмен = Неопределено;
		Объект.СуммаОплаты = 0;
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПродажаТовара") Тогда
		Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовОплаты.ПродажаТовара");
		ЗаполнитьДанныеПродажиТовара();
	ИначеЕсли ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПродажаАбонемента") Тогда
		Объект.ВидДокумента = ПредопределенноеЗначение("Перечисление.ВидыДокументовОплаты.ПродажаАбонемента");
		ЗаполнитьДанныеПродажиАбонемента();
	Иначе
		Объект.Спортсмен = Неопределено;
		Объект.СуммаОплаты = 0;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеПродажиТовара()

	ДанныеПродажи = ПолучитьДанныеПродажиТовараНаСервере(Объект.ДокументОснование);

	Если ДанныеПродажи = Неопределено Тогда
		Объект.Спортсмен = Неопределено;
		Объект.СуммаОплаты = 0;
		Возврат;
	КонецЕсли;

	Объект.Спортсмен = ДанныеПродажи.Спортсмен;
	Объект.СуммаОплаты = ДанныеПродажи.ИтоговаяСумма;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеПродажиАбонемента()

	ДанныеПродажи = ПолучитьДанныеПродажиАбонементаНаСервере(Объект.ДокументОснование);

	Если ДанныеПродажи = Неопределено Тогда
		Объект.Спортсмен = Неопределено;
		Объект.СуммаОплаты = 0;
		Возврат;
	КонецЕсли;

	Объект.Спортсмен = ДанныеПродажи.Спортсмен;
	Объект.СуммаОплаты = ДанныеПродажи.СуммаДокумента;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеПродажиТовараНаСервере(СсылкаНаПродажу)

	Если Не ЗначениеЗаполнено(СсылкаНаПродажу) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Продажа = СсылкаНаПродажу.ПолучитьОбъект();

	ДанныеПродажи = Новый Структура;
	ДанныеПродажи.Вставить("Спортсмен", Продажа.Спортсмен);
	ДанныеПродажи.Вставить("ИтоговаяСумма", Продажа.ИтоговаяСумма);

	Возврат ДанныеПродажи;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеПродажиАбонементаНаСервере(СсылкаНаПродажу)

	Если Не ЗначениеЗаполнено(СсылкаНаПродажу) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Продажа = СсылкаНаПродажу.ПолучитьОбъект();

	ДанныеПродажи = Новый Структура;
	ДанныеПродажи.Вставить("Спортсмен", Продажа.Спортсмен);
	ДанныеПродажи.Вставить("СуммаДокумента", Продажа.СуммаДокумента);

	Возврат ДанныеПродажи;

КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если Не ЗначениеЗаполнено(ТекущийОбъект.ВидДокумента) Тогда
		Сообщить("Необходимо выбрать вид документа.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийОбъект.ДокументОснование) Тогда
		Сообщить("Необходимо выбрать документ-основание.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийОбъект.Спортсмен) Тогда
		Сообщить("Не указан спортсмен.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТекущийОбъект.СпособОплаты) Тогда
		Сообщить("Необходимо выбрать способ оплаты.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ТекущийОбъект.СуммаОплаты <= 0 Тогда
		Сообщить("Сумма оплаты должна быть больше нуля.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ТекущийОбъект.ВидДокумента =
		Перечисления.ВидыДокументовОплаты.ПродажаТовара Тогда

		Если ТипЗнч(ТекущийОбъект.ДокументОснование) <>
			Тип("ДокументСсылка.ПродажаТовара") Тогда

			Сообщить("Для выбранного вида документа необходимо указать продажу товара.");
			Отказ = Истина;
			Возврат;

		КонецЕсли;

	ИначеЕсли ТекущийОбъект.ВидДокумента =
		Перечисления.ВидыДокументовОплаты.ПродажаАбонемента Тогда

		Если ТипЗнч(ТекущийОбъект.ДокументОснование) <>
			Тип("ДокументСсылка.ПродажаАбонемента") Тогда

			Сообщить("Для выбранного вида документа необходимо указать продажу абонемента.");
			Отказ = Истина;
			Возврат;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры
