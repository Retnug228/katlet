&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)

    Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
        Объект.Спортсмен = Неопределено;
        Объект.СуммаОплаты = 0;
        Возврат;
    КонецЕсли;

    Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ПродажаТовара") Тогда
        ЗаполнитьДанныеПродажиТовара();
    Иначе
        Объект.Спортсмен = Неопределено;
        Объект.СуммаОплаты = 0;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеПродажиТовара()

    ДанныеПродажи = ПолучитьДанныеПродажиТовараНаСервере(
        Объект.ДокументОснование
    );

    Если ДанныеПродажи = Неопределено Тогда
        Объект.Спортсмен = Неопределено;
        Объект.СуммаОплаты = 0;
        Возврат;
    КонецЕсли;

    Объект.Спортсмен = ДанныеПродажи.Спортсмен;
    Объект.СуммаОплаты = ДанныеПродажи.ИтоговаяСумма;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеПродажиТовараНаСервере(СсылкаНаПродажу)

    Если Не ЗначениеЗаполнено(СсылкаНаПродажу) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Продажа = СсылкаНаПродажу.ПолучитьОбъект();

    ДанныеПродажи = Новый Структура;
    ДанныеПродажи.Вставить("Спортсмен", Продажа.Спортсмен);
    ДанныеПродажи.Вставить("ИтоговаяСумма", Продажа.ИтоговаяСумма);

    Возврат ДанныеПродажи;

КонецФункции