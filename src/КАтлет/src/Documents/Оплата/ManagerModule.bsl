#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Формирует печатную форму «Чек» по документу оплаты.
//
Функция СформироватьПечатнуюФормуЧек(ДокументСсылка) Экспорт

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		ВызватьИсключение "Не указан документ оплаты для печати чека.";
	КонецЕсли;

	ОплатаОбъект = ДокументСсылка.ПолучитьОбъект();
	Макет = ПолучитьМакет("Чек");
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.КлючПараметровПечати = "Документ.Оплата.Чек";

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Кассир = ИмяКассира();
	ОбластьШапка.Параметры.Номер = ОплатаОбъект.Номер;
	ОбластьШапка.Параметры.Дата = Формат(ОплатаОбъект.Дата, "ДЛФ=D");
	ТабДок.Вывести(ОбластьШапка);

	ТабДок.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));

	Позиции = ПолучитьПозицииЧека(ОплатаОбъект);
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");

	Для Каждого Позиция Из Позиции Цикл
		ОбластьСтрока.Параметры.Наименование = Позиция.Наименование;
		ОбластьСтрока.Параметры.Цена = Позиция.Цена;
		ОбластьСтрока.Параметры.Скидка = Позиция.Скидка;
		ОбластьСтрока.Параметры.Сумма = Позиция.Сумма;
		ТабДок.Вывести(ОбластьСтрока);
	КонецЦикла;

	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.Итого = ОплатаОбъект.СуммаОплаты;
	ТабДок.Вывести(ОбластьПодвал);

	Возврат ТабДок;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяКассира()

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ЗначениеЗаполнено(ПользовательИБ.ПолноеИмя) Тогда
		Возврат ПользовательИБ.ПолноеИмя;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПользовательИБ.Имя) Тогда
		Возврат ПользовательИБ.Имя;
	КонецЕсли;
	Возврат "Кассир";

КонецФункции

Функция ПолучитьПозицииЧека(ОплатаОбъект)

	Позиции = Новый Массив;

	Если Не ЗначениеЗаполнено(ОплатаОбъект.ДокументОснование) Тогда
		Возврат Позиции;
	КонецЕсли;

	Если ТипЗнч(ОплатаОбъект.ДокументОснование) = Тип("ДокументСсылка.ПродажаАбонемента") Тогда

		Продажа = ОплатаОбъект.ДокументОснование.ПолучитьОбъект();
		Для Каждого СтрокаАбонемента Из Продажа.Абонементы Цикл
			Позиция = Новый Структура;
			Позиция.Вставить("Наименование", Строка(СтрокаАбонемента.ВидАбонемента));
			Позиция.Вставить("Цена", СтрокаАбонемента.Сумма);
			Позиция.Вставить("Скидка", 0);
			Позиция.Вставить("Сумма", СтрокаАбонемента.Сумма);
			Позиции.Добавить(Позиция);
		КонецЦикла;

	ИначеЕсли ТипЗнч(ОплатаОбъект.ДокументОснование) = Тип("ДокументСсылка.ПродажаТовара") Тогда

		Продажа = ОплатаОбъект.ДокументОснование.ПолучитьОбъект();
		Для Каждого СтрокаТовара Из Продажа.ПродажаТоваров Цикл
			Позиция = Новый Структура;
			Позиция.Вставить("Наименование", Строка(СтрокаТовара.Товар));
			Позиция.Вставить("Цена", СтрокаТовара.ЦенаПродажи);
			Позиция.Вставить("Скидка", 0);
			Позиция.Вставить("Сумма", СтрокаТовара.Сумма);
			Позиции.Добавить(Позиция);
		КонецЦикла;

	КонецЕсли;

	Возврат Позиции;

КонецФункции

#КонецОбласти

#КонецЕсли
