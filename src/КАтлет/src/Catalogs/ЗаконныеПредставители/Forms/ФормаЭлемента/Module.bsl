
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ФИОПриИзменении(Элемент)

	Части = Новый Массив;

	Если ЗначениеЗаполнено(Объект.Фамилия) Тогда
		Части.Добавить(СокрЛП(Объект.Фамилия));
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Имя) Тогда
		Части.Добавить(СокрЛП(Объект.Имя));
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Отчество) Тогда
		Части.Добавить(СокрЛП(Объект.Отчество));
	КонецЕсли;

	Объект.Description = СтрСоединить(Части, " ");

КонецПроцедуры

#КонецОбласти
