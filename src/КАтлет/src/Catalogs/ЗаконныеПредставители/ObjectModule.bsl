#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Наименование = СобратьФИО(Фамилия, Имя, Отчество);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция СобратьФИО(ФамилияПредставителя, ИмяПредставителя, ОтчествоПредставителя) Экспорт

	Части = Новый Массив;

	Если ЗначениеЗаполнено(ФамилияПредставителя) Тогда
		Части.Добавить(СокрЛП(ФамилияПредставителя));
	КонецЕсли;

	Если ЗначениеЗаполнено(ИмяПредставителя) Тогда
		Части.Добавить(СокрЛП(ИмяПредставителя));
	КонецЕсли;

	Если ЗначениеЗаполнено(ОтчествоПредставителя) Тогда
		Части.Добавить(СокрЛП(ОтчествоПредставителя));
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

#КонецОбласти

#КонецЕсли
