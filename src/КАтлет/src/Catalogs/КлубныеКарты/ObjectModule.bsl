#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	НомерКарты = СокрЛП(НомерКарты);

	Если Не ЗначениеЗаполнено(НомерКарты) Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите номер клубной карты.";
		Сообщение.Поле = "НомерКарты";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВладелецКарты) Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите владельца клубной карты.";
		Сообщение.Поле = "ВладелецКарты";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Если НомерКартыУжеИспользуется(НомерКарты, Ссылка) Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Клубная карта с номером """ + НомерКарты + """ уже существует.";
		Сообщение.Поле = "НомерКарты";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Наименование = НомерКарты;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НомерКартыУжеИспользуется(НомерКартыПроверки, СсылкаИсключения)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КлубныеКарты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КлубныеКарты КАК КлубныеКарты
	|ГДЕ
	|	КлубныеКарты.НомерКарты = &НомерКарты
	|	И КлубныеКарты.Ссылка <> &Ссылка
	|	И НЕ КлубныеКарты.ПометкаУдаления";

	Запрос.УстановитьПараметр("НомерКарты", НомерКартыПроверки);
	Запрос.УстановитьПараметр("Ссылка", СсылкаИсключения);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти

#КонецЕсли
