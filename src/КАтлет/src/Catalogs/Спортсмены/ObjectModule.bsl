#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаРегистрации) Тогда
		ДатаРегистрации = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;

	Наименование = СобратьФИО(Фамилия, Имя, Отчество);

	Если Не ЗначениеЗаполнено(ВозрастнаяГруппа) И ЗначениеЗаполнено(ДатаРождения) Тогда
		ВозрастнаяГруппа = ВозрастнаяГруппаПоДатеРождения(ДатаРождения);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция СобратьФИО(ФамилияСпортсмена, ИмяСпортсмена, ОтчествоСпортсмена) Экспорт

	Части = Новый Массив;

	Если ЗначениеЗаполнено(ФамилияСпортсмена) Тогда
		Части.Добавить(СокрЛП(ФамилияСпортсмена));
	КонецЕсли;

	Если ЗначениеЗаполнено(ИмяСпортсмена) Тогда
		Части.Добавить(СокрЛП(ИмяСпортсмена));
	КонецЕсли;

	Если ЗначениеЗаполнено(ОтчествоСпортсмена) Тогда
		Части.Добавить(СокрЛП(ОтчествоСпортсмена));
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

Функция ВозрастнаяГруппаПоДатеРождения(ДатаРожденияСпортсмена) Экспорт

	Если Не ЗначениеЗаполнено(ДатаРожденияСпортсмена) Тогда
		Возврат Перечисления.ВозрастныеГруппы.ПустаяСсылка();
	КонецЕсли;

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Возраст = Год(Сегодня) - Год(ДатаРожденияСпортсмена);

	Если Месяц(Сегодня) * 100 + День(Сегодня) < Месяц(ДатаРожденияСпортсмена) * 100 + День(ДатаРожденияСпортсмена) Тогда
		Возраст = Возраст - 1;
	КонецЕсли;

	Если Возраст < 12 Тогда
		Возврат Перечисления.ВозрастныеГруппы.Детская;
	ИначеЕсли Возраст < 18 Тогда
		Возврат Перечисления.ВозрастныеГруппы.Подростковая;
	КонецЕсли;

	Возврат Перечисления.ВозрастныеГруппы.Взрослая;

КонецФункции

#КонецОбласти

#КонецЕсли