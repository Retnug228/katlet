
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() И Не ЗначениеЗаполнено(Объект.ДатаРегистрации) Тогда
		Объект.ДатаРегистрации = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ФИОПриИзменении(Элемент)

	Части = Новый Массив;

	Если ЗначениеЗаполнено(Объект.Фамилия) Тогда
		Части.Добавить(СокрЛП(Объект.Фамилия));
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Имя) Тогда
		Части.Добавить(СокрЛП(Объект.Имя));
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Отчество) Тогда
		Части.Добавить(СокрЛП(Объект.Отчество));
	КонецЕсли;

	Объект.Description = СтрСоединить(Части, " ");

КонецПроцедуры

&НаКлиенте
Процедура ДатаРожденияПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Объект.ВозрастнаяГруппа) Или Не ЗначениеЗаполнено(Объект.ДатаРождения) Тогда
		Возврат;
	КонецЕсли;

	Объект.ВозрастнаяГруппа = ВозрастнаяГруппаНаСервере(Объект.ДатаРождения);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ВозрастнаяГруппаНаСервере(ДатаРождения)

	Спортсмен = Справочники.Спортсмены.СоздатьЭлемент();
	Возврат Спортсмен.ВозрастнаяГруппаПоДатеРождения(ДатаРождения);

КонецФункции

#КонецОбласти
