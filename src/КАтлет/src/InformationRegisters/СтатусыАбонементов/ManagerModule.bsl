#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Создаёт или обновляет статус абонемента после продажи.
// Вызывается из документа ПродажаАбонемента (P3).
//
Процедура ЗарегистрироватьАбонемент(ДокументПродажи, НомерСтрокиАбонемента, Спортсмен, КлубнаяКарта, ВидАбонемента,
	КоличествоПосещений, ДатаНачала, ДатаОкончания, ДоступноеКоличествоЗаморозок = 0) Экспорт

	Если Не ЗначениеЗаполнено(ДокументПродажи) Тогда
		ВызватьИсключение "Не указан документ продажи абонемента.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НомерСтрокиАбонемента) Тогда
		ВызватьИсключение "Не указан номер строки абонемента.";
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.СтатусыАбонементов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДокументПродажи = ДокументПродажи;
	МенеджерЗаписи.НомерСтрокиАбонемента = НомерСтрокиАбонемента;
	МенеджерЗаписи.Спортсмен = Спортсмен;
	МенеджерЗаписи.КлубнаяКарта = КлубнаяКарта;
	МенеджерЗаписи.ВидАбонемента = ВидАбонемента;
	МенеджерЗаписи.ОстатокПосещений = КоличествоПосещений;
	МенеджерЗаписи.ДатаНачала = ДатаНачала;
	МенеджерЗаписи.ДатаОкончания = ДатаОкончания;
	МенеджерЗаписи.ДоступноеКоличествоЗаморозок = ДоступноеКоличествоЗаморозок;
	МенеджерЗаписи.Заморожен = Ложь;
	МенеджерЗаписи.ДатаНачалаЗаморозки = '00010101';
	МенеджерЗаписи.ДатаОкончанияЗаморозки = '00010101';
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Создаёт статусы по всем строкам проведённой продажи абонемента.
//
Процедура ЗарегистрироватьПоДокументуПродажи(ДокументПродажи) Экспорт

	Если Не ЗначениеЗаполнено(ДокументПродажи) Тогда
		ВызватьИсключение "Не указан документ продажи абонемента.";
	КонецЕсли;

	Продажа = ДокументПродажи.ПолучитьОбъект();
	Если Продажа.Абонементы.Количество() = 0 Тогда
		ВызватьИсключение "В продаже абонемента нет строк.";
	КонецЕсли;

	УдалитьПоДокументуПродажи(ДокументПродажи);

	Для Каждого СтрокаАбонемента Из Продажа.Абонементы Цикл

		ДатаНачала = СтрокаАбонемента.ДатаНачала;
		Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
			ДатаНачала = НачалоДня(Продажа.Дата);
		КонецЕсли;

		ДатаОкончания = СтрокаАбонемента.ДатаОкончания;
		Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
			ДатаОкончания = ДатаНачала;
			Если ЗначениеЗаполнено(СтрокаАбонемента.МесяцевДлительность) Тогда
				ДатаОкончания = ДобавитьМесяц(ДатаОкончания, СтрокаАбонемента.МесяцевДлительность);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаАбонемента.ДнейДлительность) Тогда
				ДатаОкончания = ДатаОкончания + СтрокаАбонемента.ДнейДлительность;
			КонецЕсли;
		КонецЕсли;

		ЗарегистрироватьАбонемент(
			ДокументПродажи,
			СтрокаАбонемента.НомерСтроки,
			Продажа.Спортсмен,
			Продажа.Карта,
			СтрокаАбонемента.ВидАбонемента,
			СтрокаАбонемента.КоличествоПосещений,
			ДатаНачала,
			ДатаОкончания,
			СтрокаАбонемента.ДоступноеКоличествоЗаморозок);

	КонецЦикла;

КонецПроцедуры

// Удаляет все статусы, созданные по документу продажи.
//
Процедура УдалитьПоДокументуПродажи(ДокументПродажи) Экспорт

	Если Не ЗначениеЗаполнено(ДокументПродажи) Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.СтатусыАбонементов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументПродажи.Установить(ДокументПродажи);
	НаборЗаписей.Записать();

КонецПроцедуры

// Ищет действующий абонемент по клубной карте на указанную дату.
// Возвращает Структура или Неопределено.
//
Функция НайтиДействующийАбонементПоКарте(КлубнаяКарта, ДатаПроверки = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(КлубнаяКарта) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ДатаПроверки = Неопределено Тогда
		ДатаПроверки = НачалоДня(ТекущаяДатаСеанса());
	Иначе
		ДатаПроверки = НачалоДня(ДатаПроверки);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Статусы.ДокументПродажи КАК ДокументПродажи,
	|	Статусы.НомерСтрокиАбонемента КАК НомерСтрокиАбонемента,
	|	Статусы.Спортсмен КАК Спортсмен,
	|	Статусы.КлубнаяКарта КАК КлубнаяКарта,
	|	Статусы.ВидАбонемента КАК ВидАбонемента,
	|	Статусы.ОстатокПосещений КАК ОстатокПосещений,
	|	Статусы.ДатаНачала КАК ДатаНачала,
	|	Статусы.ДатаОкончания КАК ДатаОкончания,
	|	Статусы.Заморожен КАК Заморожен,
	|	Статусы.ДатаНачалаЗаморозки КАК ДатаНачалаЗаморозки,
	|	Статусы.ДатаОкончанияЗаморозки КАК ДатаОкончанияЗаморозки
	|ИЗ
	|	РегистрСведений.СтатусыАбонементов КАК Статусы
	|ГДЕ
	|	Статусы.КлубнаяКарта = &КлубнаяКарта
	|	И Статусы.ОстатокПосещений > 0
	|	И (Статусы.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Статусы.ДатаНачала <= &ДатаПроверки)
	|	И (Статусы.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Статусы.ДатаОкончания >= &ДатаПроверки
	|		ИЛИ (Статусы.Заморожен
	|			И Статусы.ДатаНачалаЗаморозки <> ДАТАВРЕМЯ(1, 1, 1)
	|			И Статусы.ДатаНачалаЗаморозки <= &ДатаПроверки
	|			И (Статусы.ДатаОкончанияЗаморозки = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ Статусы.ДатаОкончанияЗаморозки >= &ДатаПроверки)))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Статусы.ДатаОкончания,
	|	Статусы.ОстатокПосещений";

	Запрос.УстановитьПараметр("КлубнаяКарта", КлубнаяКарта);
	Запрос.УстановитьПараметр("ДатаПроверки", ДатаПроверки);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ДокументПродажи", Выборка.ДокументПродажи);
	Результат.Вставить("НомерСтрокиАбонемента", Выборка.НомерСтрокиАбонемента);
	Результат.Вставить("Спортсмен", Выборка.Спортсмен);
	Результат.Вставить("КлубнаяКарта", Выборка.КлубнаяКарта);
	Результат.Вставить("ВидАбонемента", Выборка.ВидАбонемента);
	Результат.Вставить("ОстатокПосещений", Выборка.ОстатокПосещений);
	Результат.Вставить("ДатаНачала", Выборка.ДатаНачала);
	Результат.Вставить("ДатаОкончания", Выборка.ДатаОкончания);
	Результат.Вставить("Заморожен", Выборка.Заморожен);
	Результат.Вставить("ДатаНачалаЗаморозки", Выборка.ДатаНачалаЗаморозки);
	Результат.Вставить("ДатаОкончанияЗаморозки", Выборка.ДатаОкончанияЗаморозки);

	Возврат Результат;

КонецФункции

// Списывает одно посещение. При входе во время заморозки снимает её
// без переноса неиспользованного хвоста на срок действия.
// Возвращает структуру с полями ОстатокПосещений, СнятаЗаморозка.
//
Функция СписатьПосещение(ДокументПродажи, НомерСтрокиАбонемента, ДатаВхода = Неопределено) Экспорт

	Если ДатаВхода = Неопределено Тогда
		ДатаВхода = НачалоДня(ТекущаяДатаСеанса());
	Иначе
		ДатаВхода = НачалоДня(ДатаВхода);
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.СтатусыАбонементов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДокументПродажи = ДокументПродажи;
	МенеджерЗаписи.НомерСтрокиАбонемента = НомерСтрокиАбонемента;
	МенеджерЗаписи.Прочитать();

	Если Не МенеджерЗаписи.Выбран() Тогда
		ВызватьИсключение "Статус абонемента не найден.";
	КонецЕсли;

	Если МенеджерЗаписи.ОстатокПосещений <= 0 Тогда
		ВызватьИсключение "По абонементу не осталось посещений.";
	КонецЕсли;

	СнятаЗаморозка = Ложь;
	Если МенеджерЗаписи.Заморожен
		И ЗначениеЗаполнено(МенеджерЗаписи.ДатаНачалаЗаморозки)
		И МенеджерЗаписи.ДатаНачалаЗаморозки <= ДатаВхода
		И (Не ЗначениеЗаполнено(МенеджерЗаписи.ДатаОкончанияЗаморозки)
			Или МенеджерЗаписи.ДатаОкончанияЗаморозки >= ДатаВхода) Тогда

		// Неиспользованный хвост заморозки не должен оставаться в сроке действия.
		Если ЗначениеЗаполнено(МенеджерЗаписи.ДатаОкончанияЗаморозки)
			И ЗначениеЗаполнено(МенеджерЗаписи.ДатаОкончания)
			И МенеджерЗаписи.ДатаОкончанияЗаморозки > ДатаВхода Тогда

			НеиспользованоДней = МенеджерЗаписи.ДатаОкончанияЗаморозки - ДатаВхода;
			Если НеиспользованоДней > 0 Тогда
				МенеджерЗаписи.ДатаОкончания = МенеджерЗаписи.ДатаОкончания - НеиспользованоДней;
			КонецЕсли;

		КонецЕсли;

		МенеджерЗаписи.Заморожен = Ложь;
		МенеджерЗаписи.ДатаНачалаЗаморозки = '00010101';
		МенеджерЗаписи.ДатаОкончанияЗаморозки = '00010101';
		СнятаЗаморозка = Истина;

	КонецЕсли;

	Если ЗначениеЗаполнено(МенеджерЗаписи.ДатаОкончания)
		И МенеджерЗаписи.ДатаОкончания < ДатаВхода
		И Не СнятаЗаморозка Тогда
		ВызватьИсключение "Срок действия абонемента истёк.";
	КонецЕсли;

	МенеджерЗаписи.ОстатокПосещений = МенеджерЗаписи.ОстатокПосещений - 1;
	МенеджерЗаписи.Записать();

	Результат = Новый Структура;
	Результат.Вставить("ОстатокПосещений", МенеджерЗаписи.ОстатокПосещений);
	Результат.Вставить("СнятаЗаморозка", СнятаЗаморозка);
	Результат.Вставить("Спортсмен", МенеджерЗаписи.Спортсмен);
	Результат.Вставить("ВидАбонемента", МенеджерЗаписи.ВидАбонемента);

	Возврат Результат;

КонецФункции

// Возвращает одно посещение при отмене проведения регистрации входа.
//
Процедура ВернутьПосещение(ДокументПродажи, НомерСтрокиАбонемента) Экспорт

	МенеджерЗаписи = РегистрыСведений.СтатусыАбонементов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДокументПродажи = ДокументПродажи;
	МенеджерЗаписи.НомерСтрокиАбонемента = НомерСтрокиАбонемента;
	МенеджерЗаписи.Прочитать();

	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.ОстатокПосещений = МенеджерЗаписи.ОстатокПосещений + 1;
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Замораживает абонемент и продлевает дату окончания на срок заморозки.
// Срок заморозки — не более 3 месяцев.
// Возвращает структуру с новой датой окончания и числом дней продления.
//
Функция ЗаморозитьАбонемент(ДокументПродажи, НомерСтрокиАбонемента, ДатаНачалаЗаморозки, ДатаОкончанияЗаморозки) Экспорт

	ДатаНачалаЗаморозки = НачалоДня(ДатаНачалаЗаморозки);
	ДатаОкончанияЗаморозки = НачалоДня(ДатаОкончанияЗаморозки);

	Если Не ЗначениеЗаполнено(ДатаНачалаЗаморозки) Или Не ЗначениеЗаполнено(ДатаОкончанияЗаморозки) Тогда
		ВызватьИсключение "Укажите период заморозки.";
	КонецЕсли;

	Если ДатаОкончанияЗаморозки < ДатаНачалаЗаморозки Тогда
		ВызватьИсключение "Дата окончания заморозки не может быть раньше даты начала.";
	КонецЕсли;

	Если ДатаОкончанияЗаморозки > ДобавитьМесяц(ДатаНачалаЗаморозки, 3) Тогда
		ВызватьИсключение "Срок заморозки не может превышать 3 месяца.";
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.СтатусыАбонементов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДокументПродажи = ДокументПродажи;
	МенеджерЗаписи.НомерСтрокиАбонемента = НомерСтрокиАбонемента;
	МенеджерЗаписи.Прочитать();

	Если Не МенеджерЗаписи.Выбран() Тогда
		ВызватьИсключение "Статус абонемента не найден.";
	КонецЕсли;

	Если МенеджерЗаписи.Заморожен Тогда
		ВызватьИсключение "Абонемент уже заморожен.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(МенеджерЗаписи.ВидАбонемента) Тогда
		ВызватьИсключение "У статуса абонемента не указан вид абонемента.";
	КонецЕсли;

	ВидАбонементаОбъект = МенеджерЗаписи.ВидАбонемента;
	Если Не ВидАбонементаОбъект.ОграниченаДлительность Тогда
		ВызватьИсключение "Заморозка доступна только для абонементов с ограничением по длительности.";
	КонецЕсли;

	Если Не ВидАбонементаОбъект.ВозможностьЗаморозки Тогда
		ВызватьИсключение "Для данного вида абонемента заморозка запрещена.";
	КонецЕсли;

	Если МенеджерЗаписи.ДоступноеКоличествоЗаморозок <= 0 Тогда
		ВызватьИсключение "Исчерпан лимит заморозок по абонементу.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(МенеджерЗаписи.ДатаОкончания) Тогда
		ВызватьИсключение "У абонемента не заполнена дата окончания.";
	КонецЕсли;

	ДнейПродления = (ДатаОкончанияЗаморозки - ДатаНачалаЗаморозки);
	Если ДнейПродления < 0 Тогда
		ДнейПродления = 0;
	КонецЕсли;

	ДатаОкончанияДо = МенеджерЗаписи.ДатаОкончания;
	ДатаОкончанияПосле = ДатаОкончанияДо + ДнейПродления;

	МенеджерЗаписи.Заморожен = Истина;
	МенеджерЗаписи.ДатаНачалаЗаморозки = ДатаНачалаЗаморозки;
	МенеджерЗаписи.ДатаОкончанияЗаморозки = ДатаОкончанияЗаморозки;
	МенеджерЗаписи.ДатаОкончания = ДатаОкончанияПосле;
	МенеджерЗаписи.ДоступноеКоличествоЗаморозок = МенеджерЗаписи.ДоступноеКоличествоЗаморозок - 1;
	МенеджерЗаписи.Записать();

	Результат = Новый Структура;
	Результат.Вставить("ДатаОкончанияДо", ДатаОкончанияДо);
	Результат.Вставить("ДатаОкончанияПосле", ДатаОкончанияПосле);
	Результат.Вставить("ДнейПродления", ДнейПродления);
	Результат.Вставить("Спортсмен", МенеджерЗаписи.Спортсмен);
	Результат.Вставить("КлубнаяКарта", МенеджерЗаписи.КлубнаяКарта);
	Результат.Вставить("ВидАбонемента", МенеджерЗаписи.ВидАбонемента);

	Возврат Результат;

КонецФункции

// Отменяет заморозку (при отмене проведения документа заморозки).
//
Процедура ОтменитьЗаморозку(ДокументПродажи, НомерСтрокиАбонемента, ДнейПродления) Экспорт

	МенеджерЗаписи = РегистрыСведений.СтатусыАбонементов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДокументПродажи = ДокументПродажи;
	МенеджерЗаписи.НомерСтрокиАбонемента = НомерСтрокиАбонемента;
	МенеджерЗаписи.Прочитать();

	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(МенеджерЗаписи.ДатаОкончания) И ДнейПродления > 0 Тогда
		МенеджерЗаписи.ДатаОкончания = МенеджерЗаписи.ДатаОкончания - ДнейПродления;
	КонецЕсли;

	МенеджерЗаписи.Заморожен = Ложь;
